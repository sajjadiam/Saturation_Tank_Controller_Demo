--cpu Cortex-M3
"program\startup_stm32f103xb.o"
"program\main.o"
"program\gpio.o"
"program\adc.o"
"program\dma.o"
"program\tim.o"
"program\usart.o"
"program\stm32f1xx_it.o"
"program\stm32f1xx_hal_msp.o"
"program\stm32f1xx_hal_gpio_ex.o"
"program\stm32f1xx_hal_adc.o"
"program\stm32f1xx_hal_adc_ex.o"
"program\stm32f1xx_hal.o"
"program\stm32f1xx_hal_rcc.o"
"program\stm32f1xx_hal_rcc_ex.o"
"program\stm32f1xx_hal_gpio.o"
"program\stm32f1xx_hal_dma.o"
"program\stm32f1xx_hal_cortex.o"
"program\stm32f1xx_hal_pwr.o"
"program\stm32f1xx_hal_flash.o"
"program\stm32f1xx_hal_flash_ex.o"
"program\stm32f1xx_hal_exti.o"
"program\stm32f1xx_hal_tim.o"
"program\stm32f1xx_hal_tim_ex.o"
"program\stm32f1xx_hal_uart.o"
"program\system_stm32f1xx.o"
--strict --scatter "program\program.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "program.map" -o program\program.axf